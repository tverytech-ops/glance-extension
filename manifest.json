{
  "manifest_version": 3,
  "name": "Glance Link Preview",
  "version": "2.1.1",
  "description": "Preview links in a clean overlay without leaving your current page.",
  "permissions": ["storage", "contextMenus", "declarativeNetRequestWithHostAccess", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["modal.css"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}